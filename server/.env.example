# SatQuery AI - Server Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin for Client (React frontend)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Optional for initial health check, required for database features)
MONGODB_URI=mongodb://localhost:27017/satquery_ai

# Maximum File Upload Size in bytes (e.g. 50MB for satellite imagery)
MAX_FILE_SIZE=52428800

# Future Python AI Service endpoint (Reserved for future Python microservice)
PYTHON_AI_SERVICE_URL=http://localhost:8000
